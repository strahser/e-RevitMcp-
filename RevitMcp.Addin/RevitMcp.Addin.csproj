<Project Sdk="Nice3point.Revit.Sdk/6.2.3">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <DeployAddin>false</DeployAddin>
        <LaunchRevit>false</LaunchRevit>
        <IsRepackable>false</IsRepackable>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <Configurations>Debug.R24</Configurations>
        <Configurations>$(Configurations);Release.R24</Configurations>
        <AssemblyName>RevitMcp.Addin</AssemblyName>
        <RootNamespace>RevitMcp</RootNamespace>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug.R24' ">
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release.R24' ">
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.3.40" PrivateAssets="all" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.3.40" PrivateAssets="all" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    </ItemGroup>

</Project>
